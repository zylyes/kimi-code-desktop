{
  "name": "kimi-code-desktop",
  "version": "0.19.4",
  "description": "Kimi Code 网页版桌面套壳 — 自动启动 kimi web 并嵌入桌面窗口",
  "main": "main.js",
  "author": "zyl",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "mock": "node scripts/mock-kimi-server.js",
    "pack": "electron-builder --dir",
    "dist": "npm run pack:versioned",
    "pack:versioned": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-versioned.ps1",
    "pack:versioned:ca": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-versioned.ps1 -UseSystemCA"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kimi.code.desktop",
    "productName": "Kimi Code Desktop",
    "files": [
      "main.js",
      "preload.js",
      "menu-panel.js",
      "config-manager.js",
      "skills-manager.js",
      "instances-manager.js",
      "ide-integration.js",
      "loading.html",
      "setup.html",
      "sessions.html",
      "question.html",
      "question.js",
      "question-preload.js",
      "session-export.js",
      "plugins-manager.js",
      "prompts.html",
      "help.html",
      "agents.html",
      "lan.html",
      "kimi-theme.css",
      "acp-client.js",
      "chat.html",
      "chat.js",
      "chat-preload.js",
      "permission.html",
      "permission.js",
      "permission-preload.js",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "KimiCodeDesktop-Portable.${ext}"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "qrcode": "^1.5.4",
    "ws": "^8.21.1"
  }
}
