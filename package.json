{
  "name": "kimi-code-desktop",
  "version": "1.5.0",
  "description": "Kimi Code 网页版桌面套壳 — 自动启动 kimi web 并嵌入桌面窗口",
  "main": "src/main/main.js",
  "author": "zyl",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "mock": "node scripts/mock-kimi-server.js",
    "pack": "electron-builder --dir",
    "dist": "npm run pack:versioned",
    "pack:versioned": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-versioned.ps1",
    "pack:versioned:ca": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-versioned.ps1 -UseSystemCA"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kimi.code.desktop",
    "productName": "Kimi Code Desktop",
    "files": [
      "src/main/*.js",
      "src/preload/*.js",
      "src/pages/*.html",
      "src/pages/*.js",
      "src/pages/vendor/**",
      "src/styles/*.css",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] },
        { "target": "7z", "arch": ["x64"] }
      ],
      "artifactName": "KimiCodeDesktop-${version}-${arch}.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "KimiCodeDesktop-Setup-${version}.${ext}",
      "shortcutName": "Kimi Code Desktop"
    },
    "portable": {
      "artifactName": "KimiCodeDesktop-Portable-${version}.${ext}"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "qrcode": "^1.5.4",
    "ws": "^8.21.1"
  }
}
